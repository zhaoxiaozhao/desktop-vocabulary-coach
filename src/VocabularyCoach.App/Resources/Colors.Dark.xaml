<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#334155" />
    <SolidColorBrush x:Key="PositiveBrush" Color="#10B981" />
    <SolidColorBrush x:Key="VagueBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#334155" />
    <SolidColorBrush x:Key="ExampleTextBrush" Color="#CBD5E1" />

</ResourceDictionary>
