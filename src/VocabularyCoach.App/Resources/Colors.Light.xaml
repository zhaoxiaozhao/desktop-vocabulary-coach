<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="PositiveBrush" Color="#059669" />
    <SolidColorBrush x:Key="VagueBrush" Color="#D97706" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ExampleTextBrush" Color="#374151" />

</ResourceDictionary>
