<Window x:Class="VocabularyCoach.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="检查更新" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding CurrentVersionText}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="18,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding StatusText}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource BodyText}"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="18,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Style="{StaticResource BodyText}"
                           Text="{Binding NotesText}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar Height="8"
                         Maximum="100"
                         Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="更新会校验签名与 SHA256；安装完成后应用会自动重新启动。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenReleasesPageCommand}"
                    Content="打开发布页"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Grid.Column="1"
                    Command="{Binding CheckAgainCommand}"
                    Content="重新检查"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Command="{Binding InstallCommand}"
                    Content="下载并安装"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Grid.Column="3"
                    Margin="10,0,0,0"
                    Click="OnCloseClick"
                    Content="关闭"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
