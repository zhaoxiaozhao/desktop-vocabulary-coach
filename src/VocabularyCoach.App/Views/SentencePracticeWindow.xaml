<Window x:Class="VocabularyCoach.App.Views.SentencePracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="句子练习"
        Width="780"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="30,24,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageTitleText}" Text="句子练习" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="把单词填进句子里，练口语常用句型和语法。" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource CaptionText}"
                           Text="{Binding ProgressText}" />
                <TextBlock Margin="0,4,0,0"
                           HorizontalAlignment="Right"
                           Style="{StaticResource CaptionText}"
                           Text="{Binding ScoreText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <!-- 加载中 -->
            <Border Padding="24,30"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="正在准备句子…" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource BodyText}"
                               Text="AI 已开启时会优先用 AI 生成；失败或关闭时自动使用离线句库。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Padding="8,3"
                                Background="{DynamicResource SubtleFillBrush}"
                                CornerRadius="999">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding SourceText}" />
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="8,3"
                                Background="{DynamicResource SubtleFillBrush}"
                                CornerRadius="999"
                                Visibility="{Binding ShowPattern, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding PatternText}" />
                        </Border>
                    </StackPanel>

                    <Border Margin="0,12,0,0"
                            Padding="22,20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       LineHeight="31"
                                       Text="{Binding SentenceText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       LineHeight="22"
                                       Text="{Binding TranslationText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 选择答案 -->
                    <ItemsControl Margin="0,14,0,0"
                                  ItemsSource="{Binding Options}"
                                  Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ChooseOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource QuizChoiceButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Text="{Binding Text}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 手动输入 -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding ShowTyping, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Height="40"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding TypedAnswer, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入英文单词或短语" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="不区分大小写；短语可以带空格。"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Command="{Binding SubmitTypingCommand}"
                                    Content="提交答案"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding ShowAnswerCommand}"
                                    Content="不会，显示答案"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 作答反馈 -->
                    <Border Margin="0,14,0,0"
                            Padding="18,16"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding ResultText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCorrect}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource BodyText}"
                                       Text="{Binding CorrectAnswerText, StringFormat=正确答案：{0}}"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,12,0,0"
                                    Padding="12,10"
                                    Background="{DynamicResource SubtleFillBrush}"
                                    CornerRadius="9"
                                    Visibility="{Binding ShowGrammarNote, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="语法 / 固定句式" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               LineHeight="20"
                                               Text="{Binding GrammarNote}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 本组结束 -->
            <Border Padding="26,28"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SectionTitleText}"
                               Text="本组完成" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="{Binding SummaryText}" />
                    <StackPanel Margin="0,20,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Command="{Binding RestartCommand}"
                                Content="再来一组"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding CloseCommand}"
                                Content="关闭"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Command="{Binding ToggleTypingCommand}"
                    Content="{Binding TypingToggleText}"
                    Style="{StaticResource GhostButtonStyle}"
                    Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Command="{Binding NextCommand}"
                    Content="下一句"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding ShowFooterNext, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="3"
                    Margin="10,0,0,0"
                    Click="OnCloseClick"
                    Content="结束练习"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
