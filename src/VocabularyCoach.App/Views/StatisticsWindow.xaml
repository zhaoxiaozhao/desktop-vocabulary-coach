<Window x:Class="VocabularyCoach.App.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日学习统计"
        Width="440"
        Height="520"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="今日学习统计" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding DateText}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Border Padding="18,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="今日弹卡总数" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource StatValueText}"
                               Text="{Binding Today.TotalSessions}" />
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="18,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource BodyText}"
                               Text="认识" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource StatValueText}"
                               Text="{Binding Today.Recognized}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,8,0,0"
                               Style="{StaticResource BodyText}"
                               Text="模糊" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Margin="0,8,0,0"
                               Style="{StaticResource StatValueText}"
                               Text="{Binding Today.Vague}" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="0,8,0,0"
                               Style="{StaticResource BodyText}"
                               Text="不认识" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Margin="0,8,0,0"
                               Style="{StaticResource StatValueText}"
                               Text="{Binding Today.Unknown}" />
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="18,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource BodyText}"
                               Text="关闭 / 稍后提醒 / 超时" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource StatValueText}">
                        <Run Text="{Binding Today.Dismissed, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding Today.Snoozed, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding Today.Timeout, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,8,0,0"
                               Style="{StaticResource BodyText}"
                               Text="今日开始学习的单词" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Margin="0,8,0,0"
                               Style="{StaticResource StatValueText}"
                               Text="{Binding Today.WordsLearnedToday}" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="0,8,0,0"
                               Style="{StaticResource BodyText}"
                               Text="当前待复习" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Margin="0,8,0,0"
                               Style="{StaticResource StatValueText}"
                               Text="{Binding Today.DueReviewCount}" />
                </Grid>
            </Border>

            <TextBlock Margin="0,12,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="统计直接来自本地学习会话与复习记录，与数据库一致。" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding Status}" />

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Click="OnCloseClick"
                    Content="关闭"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
