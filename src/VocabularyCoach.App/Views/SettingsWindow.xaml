<Window x:Class="VocabularyCoach.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VocabularyCoach.App.Controls"
        Title="设置"
        Width="660"
        Height="800"
        MinWidth="600"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="设置" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource BodyText}"
                       Text="修改后点击“保存并应用”，无需重启。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 提醒 -->
                <Border Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="提醒" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="启用桌面提醒"
                                  IsChecked="{Binding RemindersEnabled}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="最短弹出间隔" />
                            <TextBox Grid.Column="1"
                                     Width="90"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding MinIntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="分钟（支持小数）" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="最长弹出间隔" />
                            <TextBox Grid.Column="1"
                                     Width="90"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding MaxIntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="分钟" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="每小时最多弹出" />
                            <TextBox Grid.Column="1"
                                     Width="90"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding MaxPopupsPerHour, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="次" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="勿扰时段" />
                            <TextBox Grid.Column="1"
                                     Width="90"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding QuietHoursStart, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="至" />
                            <TextBox Grid.Column="3"
                                     Width="90"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding QuietHoursEnd, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="空闲超过" />
                            <TextBox Grid.Column="1"
                                     Width="90"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="分钟后不弹" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="“暂停至明天”恢复时间" />
                            <TextBox Grid.Column="1"
                                     Width="90"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding PauseUntilTomorrowTime, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="HH:mm（本地时间）" />
                        </Grid>

                        <CheckBox Margin="0,12,0,0"
                                  Content="检测用户空闲状态"
                                  IsChecked="{Binding EnableIdleDetection}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="全屏应用期间不弹出"
                                  IsChecked="{Binding DetectFullscreen}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="开机自动启动（静默进入系统托盘）"
                                  IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </Border>

                <!-- 学习 -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="学习" />

                        <TextBlock Margin="0,12,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="推荐模式" />
                        <ComboBox Width="300"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                  ItemsSource="{Binding RecommendationModes}"
                                  SelectedValue="{Binding RecommendationMode}"
                                  SelectedValuePath="Value" />

                        <TextBlock Margin="0,12,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="复习方式" />
                        <ComboBox Width="320"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                  ItemsSource="{Binding InteractionModes}"
                                  SelectedValue="{Binding InteractionMode}"
                                  SelectedValuePath="Value" />

                        <TextBlock Margin="0,12,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="难度模式" />
                        <ComboBox Width="300"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                  ItemsSource="{Binding DifficultyModes}"
                                  SelectedValue="{Binding DifficultyMode}"
                                  SelectedValuePath="Value" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="手动难度（1–4）" />
                            <ComboBox Grid.Column="1"
                                      Width="90"
                                      ItemsSource="{Binding DifficultyLevels}"
                                      SelectedItem="{Binding ManualDifficulty}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="仅在手动模式生效" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="新词倾向" />
                            <Slider Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Maximum="1"
                                    Minimum="0"
                                    TickFrequency="0.05"
                                    Value="{Binding NewWordRatio}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="{Binding NewWordRatio, StringFormat={}{0:0.00}}" />
                        </Grid>
                        <TextBlock Margin="190,2,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="0 = 只复习，1 = 只新词；自适应下调时会在基础值上降低。" />
                    </StackPanel>
                </Border>

                <!-- 句子练习 -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="句子练习" />

                        <TextBlock Margin="0,12,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="作答方式" />
                        <ComboBox Width="320"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                  ItemsSource="{Binding SentenceAnswerModes}"
                                  SelectedValue="{Binding SentenceAnswerMode}"
                                  SelectedValuePath="Value" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="随机弹卡时偶尔打开句子练习"
                                  IsChecked="{Binding SentencePracticePopupEnabled}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="概率" />
                            <ComboBox Width="80"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding SentencePopupChances}"
                                      SelectedItem="{Binding SentencePracticePopupChancePercent}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="%" />
                            <TextBlock Margin="20,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="每次" />
                            <ComboBox Width="70"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding SentencePopupCounts}"
                                      SelectedItem="{Binding SentencePracticePopupSentenceCount}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="句" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="到点弹卡时按该概率改为打开句子练习；关闭窗口后继续正常提醒。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 生词捕获 -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="生词捕获" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource BodyText}"
                                   Text="在任意应用中选中 1–5 个英文单词，按设置的热键加入生词本；捕获的词会立即进入复习队列。" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="启用生词捕获热键"
                                  IsChecked="{Binding CaptureEnabled}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="捕获热键" />
                        <controls:HotkeyBox Width="220"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SearchTextBoxStyle}"
                                            Hotkey="{Binding CaptureHotkey, Mode=TwoWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="点击输入框后按下新的组合键，例如 Ctrl+Alt+W。"
                                   TextWrapping="Wrap" />

                        <CheckBox Margin="0,10,0,0"
                                  Content="词库已有释义时静默加入（不再弹确认窗）"
                                  IsChecked="{Binding CaptureSilentAdd}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="捕获后显示托盘气泡提示（关闭后完全无提示）"
                                  IsChecked="{Binding CaptureShowNotification}" />
                    </StackPanel>
                </Border>

                <!-- 中文转英文 -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="中文转英文" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource BodyText}"
                                   Text="在任意应用中选中中文，按设置的热键：先用 AI 翻译，默认直接原位替换成英文。只发送当前选中的文字。" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="启用中文转英文热键"
                                  IsChecked="{Binding ChineseToEnglishEnabled}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="翻译热键" />
                        <controls:HotkeyBox Width="220"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SearchTextBoxStyle}"
                                            Hotkey="{Binding TranslateHotkey, Mode=TwoWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="点击输入框后按下新的组合键，例如 Ctrl+Alt+T。"
                                   TextWrapping="Wrap" />

                        <CheckBox Margin="0,10,0,0"
                                  Content="替换前显示预览（关闭后直接替换，可按 Ctrl+Z 撤销）"
                                  IsChecked="{Binding ChineseToEnglishPreviewEnabled}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="需要先启用 AI 并配置可用连接；翻译失败时不会替换原文。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 显示 -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="显示" />

                        <TextBlock Margin="0,12,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="卡片主题" />
                        <ComboBox Width="180"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedValue="{Binding Theme}"
                                  SelectedValuePath="Value" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="显示音标"
                                  IsChecked="{Binding ShowPhonetic}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="弹出时自动展开释义"
                                  IsChecked="{Binding AutoExpand}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="启用淡入淡出动画"
                                  IsChecked="{Binding Animate}" />
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="数据" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource BodyText}"
                                   Text="学习数据仅保存在本机。备份使用 SQLite 在线备份，可在应用运行时执行。" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Command="{Binding BackupCommand}"
                                    Content="备份数据库…"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding RestoreCommand}"
                                    Content="从备份恢复…"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding OpenDataFolderCommand}"
                                    Content="打开数据目录"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI -->
                <Border Margin="0,12,0,0"
                        Padding="18,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="AI 增强（可选）" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="启用 AI 增强（失败时自动回退本地词库）"
                                  IsChecked="{Binding AiEnabled}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="连接" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Width="300"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding AiConnectionOptions}"
                                      SelectedValue="{Binding SelectedAiConnectionId}"
                                      SelectedValuePath="Id">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddAiConnectionCommand}"
                                    Content="新增"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteAiConnectionCommand}"
                                    Content="删除"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <CheckBox Margin="0,8,0,0"
                                  Content="自动模式：按列表顺序尝试启用的连接"
                                  IsChecked="{Binding AiAutoMode}" />
                        <CheckBox Margin="0,6,0,0"
                                  Content="启用当前连接"
                                  IsChecked="{Binding SelectedAiConnectionEnabled}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="连接名称" />
                        <TextBox Width="300"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SelectedAiConnectionName, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="服务商（OpenAI-compatible，兼容中美主流服务）" />
                        <ComboBox Width="320"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource EnumOptionTemplate}"
                                  ItemsSource="{Binding AiPresets}"
                                  SelectedValue="{Binding SelectedAiPreset}"
                                  SelectedValuePath="Value" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="Base URL" />
                        <TextBox Width="420"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding AiBaseUrl, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="模型名称" />
                        <TextBox Width="280"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding AiModel, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="句子练习模型（可选）" />
                        <TextBox Width="280"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SentencePracticeModel, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Margin="0,4,0,0"
                                   MaxWidth="500"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource CaptionText}"
                                   Text="留空则跟随上面的模型；句子练习建议填 glm-4-flash（非推理模型，批量生成更快）。"
                                   TextWrapping="Wrap" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="电脑空闲时后台生成例句（保存到离线库）"
                                  IsChecked="{Binding SentenceGenerationEnabled}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="每天" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Margin="0,0,8,0"
                                     TextAlignment="Center"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding SentenceGenerationRunsPerDay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="1–6 组" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="组，每组" />
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Margin="0,0,8,0"
                                     TextAlignment="Center"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding SentenceGenerationBatchSize, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="1–10 句" />
                            <TextBlock Grid.Row="0" Grid.Column="4"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="句" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Margin="0,8,8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="空闲" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Margin="0,8,8,0"
                                     TextAlignment="Center"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="{Binding SentenceGenerationIdleMinutes, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="1–120 分钟" />
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}"
                                       Text="分钟后生成" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="使用「句子练习模型」；AI 关闭时不会运行。生成结果保存在 sentences.generated.json，句子练习会优先使用。"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,10,0,6"
                                   Style="{StaticResource BodyText}"
                                   Text="API Key（Windows DPAPI 加密保存，留空表示不修改）" />
                        <PasswordBox x:Name="ApiKeyBox"
                                     Width="320"
                                     Padding="10,7"
                                     HorizontalAlignment="Left"
                                     PasswordChanged="OnApiKeyPasswordChanged" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="测试连接优先使用输入框中的 Key；测试已保存的 Key 请先清空输入框。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="Key 必须与服务商/Base URL 匹配（智谱 id.secret，DeepSeek/OpenAI 以 sk- 开头）。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding ApiKeyStatus}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Command="{Binding TestAiCommand}"
                                    Content="测试连接"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding ClearApiKeyCommand}"
                                    Content="清除已保存 Key"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding AiTestStatus}" />

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="AI 只接收当前单词与本地中文释义，不上传学习记录；无 Key、断网或请求失败时卡片功能不受影响。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    Content="保存并应用"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Command="{Binding CloseCommand}"
                    Content="关闭"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
