<Window x:Class="VocabularyCoach.App.Views.CapturedWordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生词本"
        Width="620"
        Height="640"
        MinWidth="520"
        MinHeight="420"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="生词本" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource BodyText}"
                       Text="捕获的单词和短语会立即进入复习队列；选择题模式下会自动生成释义选项。" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,4"
                                        Padding="12,10"
                                        Background="{DynamicResource SubtleFillBrush}"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Word}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           VerticalAlignment="Bottom"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding Phonetic}" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding IsLearning, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource VagueBrush}"
                                                               Text="复习中" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding DefinitionZh}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource CaptionText}"
                                                       Text="{Binding CapturedAtText}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource CaptionText}"
                                                       Text="{Binding CaptureText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="还没有捕获生词" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="在任意应用中选中单词，按 Ctrl+Alt+W 即可记录。" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding Status}" />

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Click="OnCloseClick"
                    Content="关闭"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
