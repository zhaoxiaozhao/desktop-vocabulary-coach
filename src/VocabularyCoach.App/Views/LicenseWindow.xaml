<Window x:Class="VocabularyCoach.App.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="许可证"
        Width="620"
        Height="540"
        MinWidth="560"
        MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="许可证" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource BodyText}"
                       Text="30 天全功能试用，无需注册；激活后永久使用，不绑定设备。" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="18,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding StatusText}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource BodyText}"
                           Text="{Binding DetailText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="18,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="输入激活码" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="激活码以 DVC1. 开头，购买后会发送完整文本，直接粘贴即可。" />
                <TextBox Margin="0,10,0,0"
                         Height="40"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="粘贴完整激活码" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Command="{Binding ActivateCommand}"
                            Content="激活"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="没有激活码？可以先在官网查看功能与下载；购买后激活码会通过你购买的渠道发送。"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="提示：激活码只在本机保存，可备份 %LocalAppData%\DesktopVocabularyCoach\license.dat；换电脑后重新粘贴同一个激活码即可。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}"
                       Text="一次买断，无订阅。" />

            <Button Grid.Column="1"
                    Command="{Binding OpenPurchasePageCommand}"
                    Content="查看购买方式"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Click="OnCloseClick"
                    Content="关闭"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
