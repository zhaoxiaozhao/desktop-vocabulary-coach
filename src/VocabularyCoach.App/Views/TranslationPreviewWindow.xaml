<Window x:Class="VocabularyCoach.App.Views.TranslationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="中文转英文"
        Width="600"
        SizeToContent="Height"
        MaxHeight="720"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border Margin="18"
            Padding="22,18"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleText}" Text="中文转英文" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource BodyText}"
                       Text="确认或修改译文后替换原选区。替换失败时，可复制译文后手动粘贴。"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,6"
                       Style="{StaticResource BodyText}"
                       Text="原文" />
            <TextBox x:Name="OriginalBox"
                     MinHeight="64"
                     MaxHeight="140"
                     Padding="10,8"
                     AcceptsReturn="True"
                     Background="{DynamicResource SubtleFillBrush}"
                     BorderBrush="{DynamicResource OutlineBrush}"
                     BorderThickness="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Margin="0,14,0,6"
                       Style="{StaticResource BodyText}"
                       Text="英文（可直接修改）" />
            <TextBox x:Name="TranslationBox"
                     MinHeight="88"
                     MaxHeight="220"
                     Padding="10,8"
                     AcceptsReturn="True"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource OutlineBrush}"
                     BorderThickness="1"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Click="OnReplaceClick"
                        Content="替换原文"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Margin="10,0,0,0"
                        Click="OnCopyClick"
                        Content="复制译文"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="10,0,0,0"
                        Click="OnCancelClick"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
