<Window x:Class="VocabularyCoach.App.Views.CaptureWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记录生词"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Margin="18"
            Padding="22,18"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleText}" Text="记录生词" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource BodyText}"
                       Text="选中单词或短语后按 Ctrl+Alt+W。支持 1–5 个英文单词。" />

            <TextBlock Margin="0,16,0,6"
                       Style="{StaticResource BodyText}"
                       Text="单词 / 短语" />
            <TextBox x:Name="WordBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     Text="{Binding WordText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Phonetic}"
                           Visibility="{Binding IsFound, Converter={StaticResource BoolToVisibility}}" />
                <Border Margin="10,0,0,0"
                        Padding="7,2"
                        Background="{DynamicResource SubtleFillBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsAlreadyLearning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource VagueBrush}"
                               Text="已在复习计划中" />
                </Border>
            </StackPanel>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding IsFound, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionText}" Text="词库释义" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SuggestedDefinition}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding ShowDefinitionInput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,0,6"
                           Style="{StaticResource BodyText}"
                           Text="中文释义（词库未收录时必填）" />
                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding DefinitionZh, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <CheckBox Margin="0,14,0,0"
                      Content="以后静默加入（词库已有释义时不再弹窗）"
                      IsChecked="{Binding SilentAdd}" />

            <TextBlock Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding AddCommand}"
                        Content="加入生词本"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Margin="10,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
