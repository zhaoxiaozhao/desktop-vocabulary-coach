<Window x:Class="VocabularyCoach.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用"
        Width="560"
        Height="620"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="欢迎使用 Desktop Vocabulary Coach" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource BodyText}"
                       Text="应用会常驻系统托盘，在合适的时间随机推送单词卡片。先确认几个基础设置，之后都可以在设置中修改。" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <Border Padding="18,16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="英语水平" />
                    <ComboBox Margin="0,10,0,0"
                              Width="360"
                              HorizontalAlignment="Left"
                              ItemTemplate="{StaticResource EnumOptionTemplate}"
                              ItemsSource="{Binding Levels}"
                              SelectedValue="{Binding SelectedLevel}"
                              SelectedValuePath="Value" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="选择“自适应”会根据后续反馈自动调整难度。" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="18,16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="提醒节奏" />
                    <ComboBox Margin="0,10,0,0"
                              Width="360"
                              HorizontalAlignment="Left"
                              ItemTemplate="{StaticResource EnumOptionTemplate}"
                              ItemsSource="{Binding Paces}"
                              SelectedValue="{Binding SelectedPace}"
                              SelectedValuePath="Value" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyText}"
                                   Text="勿扰时段" />
                        <TextBox Grid.Column="1"
                                 Width="90"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding QuietHoursStart, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="至" />
                        <TextBox Grid.Column="3"
                                 Width="90"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding QuietHoursEnd, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="18,16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <CheckBox Content="完成设置后立即弹出一张测试卡片"
                              IsChecked="{Binding ShowTestCard}" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="AI 增强是可选项，默认关闭，可稍后在设置中配置服务商与 API Key；核心功能完全离线可用。" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Command="{Binding SkipCommand}"
                    Content="使用默认设置"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Command="{Binding FinishCommand}"
                    Content="开始使用"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
