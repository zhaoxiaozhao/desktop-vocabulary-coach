<Window x:Class="VocabularyCoach.App.Views.WordCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VocabularyCoach.App.Converters"
        Title="单词卡片"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>

    <Border x:Name="CardRoot"
            Margin="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="#EDEFF2"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown"
            MouseMove="OnDragHandleMouseMove"
            MouseLeftButtonUp="OnDragHandleMouseLeftButtonUp">

        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="8"
                              Direction="270"
                              Opacity="0.16"
                              Color="#111827" />
        </Border.Effect>

        <Grid Margin="20,16,16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 单词 + 关闭 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding HeaderText}"
                           TextWrapping="Wrap"
                           ToolTip="{Binding HeaderText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="26" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReverseQuiz}" Value="True">
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="LineHeight" Value="27" />
                                    <Setter Property="TextTrimming" Value="None" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding DismissCommand}"
                        Content="✕"
                        Style="{StaticResource CloseButtonStyle}" />
            </Grid>

            <!-- 音标 / 发音 -->
            <StackPanel Grid.Row="1"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowPronunciationRow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Phonetic}"
                           Visibility="{Binding HasPhonetic, Converter={StaticResource BoolToVisibility}}" />

                <Button Margin="2,-3,0,-3"
                        Padding="7,4"
                        Command="{Binding SpeakCommand}"
                        Content="🔊"
                        FontSize="13"
                        Style="{StaticResource GhostButtonStyle}"
                        ToolTip="朗读单词"
                        Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- 展开后的释义与例句 -->
            <StackPanel Grid.Row="2"
                        Margin="0,10,0,0"
                        Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Border Margin="0,1,8,0"
                            Padding="6,2"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SubtleFillBrush}"
                            CornerRadius="5"
                            Visibility="{Binding HasPartOfSpeech, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding PartOfSpeech}" />
                    </Border>

                    <TextBlock MaxWidth="270"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               LineHeight="22"
                               Text="{Binding DefinitionZh}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding HasExample, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="13"
                               FontStyle="Italic"
                               Foreground="{DynamicResource ExampleTextBrush}"
                               LineHeight="20"
                               Text="{Binding ExampleEn}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="19"
                               Text="{Binding ExampleZh}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- AI 可选增强 -->
                <Border Margin="0,10,0,0"
                        Padding="10,8"
                        Background="{DynamicResource SubtleFillBrush}"
                        CornerRadius="8"
                        Visibility="{Binding HasAiNotes, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="AI 增强" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   LineHeight="18"
                                   Text="{Binding AiExplanation}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasAiExplanation, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   LineHeight="18"
                                   Text="{Binding ConfusableNote}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasConfusableNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 操作区 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <!-- 自我评估 -->
                <StackPanel Visibility="{Binding IsQuiz, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                        <!-- 折叠状态：查看释义 -->
                        <Button Command="{Binding ToggleExpandCommand}"
                                Content="查看释义 ▾"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- 展开状态：反馈 -->
                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,3,0"
                                        Background="{DynamicResource PositiveBrush}"
                                        Command="{Binding MarkRecognizedCommand}"
                                        Content="认识"
                                        Style="{StaticResource FeedbackButtonStyle}"
                                        ToolTip="回忆成功，拉长复习间隔" />

                                <Button Grid.Column="1"
                                        Margin="3,0"
                                        Background="{DynamicResource VagueBrush}"
                                        Command="{Binding MarkVagueCommand}"
                                        Content="模糊"
                                        Style="{StaticResource FeedbackButtonStyle}"
                                        ToolTip="有印象但不牢固，短间隔复习" />

                                <Button Grid.Column="2"
                                        Margin="3,0,0,0"
                                        Background="{DynamicResource NegativeBrush}"
                                        Command="{Binding MarkUnknownCommand}"
                                        Content="不认识"
                                        Style="{StaticResource FeedbackButtonStyle}"
                                        ToolTip="未能回忆，尽快再次学习" />
                            </Grid>

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding SnoozeCommand}"
                                    Content="{Binding SnoozeLabel}"
                                    FontSize="12"
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTip="关闭卡片且不更新掌握状态，等待下一次调度" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 选择释义 -->
                <StackPanel Visibility="{Binding IsQuiz, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding QuizPrompt}" />

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding QuizChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ChooseAnswerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource QuizChoiceButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Text="{Binding Label}" />

                                        <TextBlock Grid.Column="1"
                                                   FontSize="13"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   LineHeight="19"
                                                   Text="{Binding Text}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,4,0,0"
                                Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding AnswerBanner}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastAnswerCorrect}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUnknownSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource VagueBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Margin="0,10,0,0"
                                Command="{Binding ContinueQuizCommand}"
                                Content="继续"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
