<Window x:Class="VocabularyCoach.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Vocabulary Coach"
        Width="780"
        Height="780"
        MinWidth="640"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/VocabularyCoach;component/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,20">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="Desktop Vocabulary Coach" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource BodyText}"
                       Text="把碎片时间变成单词记忆 · 常驻托盘 · 随机推送 · 低负担复习" />
        </StackPanel>

        <!-- 运行状态 -->
        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="22,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource SectionTitleText}"
                               Text="运行状态" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding VersionSummary}" />
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             Fill="#10B981" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding LibrarySummary}" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SchedulerSummary}" />
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource TextMutedBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding PauseSummary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 手动弹卡 -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="22,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="立即体验" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource BodyText}"
                           Text="从本地词库随机弹出一张卡片，验证卡片布局、发音、展开释义与反馈按钮；三种反馈会写入学习记录并安排下次复习。" />

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <Button Command="{Binding ShowCardCommand}"
                            Content="立即弹出一个单词"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Button Margin="10,0,0,0"
                            Command="{Binding OpenDataFolderCommand}"
                            Content="打开数据目录"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <Button Margin="10,0,0,0"
                            Command="{Binding OpenLogFolderCommand}"
                            Content="打开日志目录"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 查词 -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="22,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="本地查词" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource BodyText}"
                           Text="查询 SQLite 词库中的任意单词，查看音标与全部释义。数据完全离线。" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如 resilient" />

                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="20,9"
                            Command="{Binding SearchCommand}"
                            Content="查询"
                            IsDefault="True"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <!-- 查询结果 -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding HasSearchResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding SearchResult.Word}" />
                        <TextBlock Margin="10,0,0,1"
                                   VerticalAlignment="Bottom"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SearchResult.DisplayPhonetic}" />
                        <TextBlock Margin="10,0,0,1"
                                   Padding="7,2"
                                   VerticalAlignment="Bottom"
                                   Background="{DynamicResource SubtleFillBrush}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="难度 " />
                            <Run Text="{Binding SearchResult.Difficulty, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SearchResult.Definitions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding PartOfSpeech}" />

                                    <TextBlock Grid.Column="1"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               LineHeight="22"
                                               Text="{Binding DefinitionZh}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="{Binding SearchStatus}" />
                <Border Height="1"
                        Margin="0,14,0,12"
                        Background="{DynamicResource OutlineBrush}" />

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ImportLibraryCommand}"
                            Content="导入词库…"
                            Padding="14,7"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="支持 JSON 或 CSV，按单词去重，不会覆盖学习进度" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding ImportStatus}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="5">
            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,12" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="关闭窗口只会隐藏到系统托盘，应用继续在后台运行；请从托盘菜单选择“退出”彻底结束进程。" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource CaptionText}"
                       Text="{Binding DataDirectoryText}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
