{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Card": {
    "Width": 380,
    "EdgeMargin": 24,
    "AutoCloseSeconds": 60,
    "Animate": true,
    "ShowPhonetic": true,
    "AutoExpand": false
  },
  "Scheduler": {
    "MinIntervalMinutes": 12,
    "MaxIntervalMinutes": 35,
    "MaxPopupsPerHour": 4,
    "QuietHoursStart": "22:30",
    "QuietHoursEnd": "08:00",
    "IdleThresholdMinutes": 3,
    "EnableIdleDetection": true,
    "DetectFullscreen": true,
    "RecheckDelayMinutes": 2
  },
  "Recommendation": {
    "NewWordRatio": 0.6,
    "ReviewPressureThreshold": 2,
    "OverdueGraceHours": 6,
    "ReviewCandidateLimit": 20
  },
  "Update": {
    "CheckDelaySeconds": 30,
    "CheckIntervalHours": 24,
    "ManifestUrls": [
      "https://raw.githubusercontent.com/zhaoxiaozhao/desktop-vocabulary-coach/main/updates/latest.json"
    ]
  }
}
